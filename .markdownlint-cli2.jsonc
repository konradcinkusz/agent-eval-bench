{
  // File selection only. Rule configuration lives in .markdownlint.jsonc so it
  // can be inherited and selectively overridden by nested config files.
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    "**/bin/**",
    "**/obj/**",

    // The judge prompt is not documentation, it is input to a model, and its RAW
    // text is what gets read. MD029 would rewrite its numbered rules to "1." for
    // every item — correct Markdown, and a list of six rules all called 1 for the
    // thing that has to follow them. Lint rules written for human readers do not
    // apply to a file whose reader is not human.
    "evals/rubrics/judge-prompt.md",

    // Same reasoning for the agent's own prompts. These are shipped into the image
    // and read verbatim by a model; the numbering is part of what the model is being
    // told, not a Markdown style choice.
    "prompts/**"
  ]
}
