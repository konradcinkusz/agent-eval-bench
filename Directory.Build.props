<Project>

  <!--
    Directory.Build.props — one place where every project in this repository gets its
    target framework, language version, analyzer posture and package metadata.

    Rationale: REPO-BASELINE.md §1 — "Ten .csproj files each pinning their own package
    versions; upgrading one library means ten diffs and version skew inside one solution."
    Package *versions* live in Directory.Packages.props (central package management);
    everything that is not a version lives here.

    This file is inert until the first project arrives in Phase 2. It is committed now
    so that no project is ever created without it.
  -->

  <PropertyGroup Label="Target framework and language">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Globalization stays ON, against the usual container-slimming advice.
      Resolving "next Friday" and "probably tomorrow" in the caller's timezone and
      culture is load-bearing behaviour for this agent, and it is the behaviour the
      ambiguity scenarios attack. InvariantGlobalization=true would make
      CultureInfo.GetCultureInfo("es-ES") silently return the invariant culture —
      a wrong answer with no error, which is the worst failure mode an eval can face.
      The runtime image therefore carries ICU and tzdata; that cost is declared,
      not assumed (P6: "native dependencies are declared, not assumed").
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <PropertyGroup Label="Build correctness">
    <!--
      Warnings are errors everywhere, including local builds. A warning that is an
      error only in CI is a warning that gets pushed.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 (missing XML comment on a public member) off: the documentation file is
      generated for the analyzer surface, not to force a doc comment on every DTO.
      P14 puts reasoning in docs/, not in a comment on every property — and the
      estate's recorded failure is credentials pasted into XML doc comments as
      "documentation of each property's value".
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="Central package management">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- A restore that silently accepts a vulnerable transitive package is not a restore. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup Label="Vulnerability policy">
    <!--
      Audit findings arrive as warnings, and TreatWarningsAsErrors would turn every
      one of them into a red build on an unrelated PR. The policy is graded instead:

        NU1901 (low) / NU1902 (moderate)   → warning; visible, does not block
        NU1903 (high) / NU1904 (critical)  → error;   blocks the merge

      An advisory that blocks unrelated work gets suppressed wholesale within a
      month; one that is merely loud gets read. High and critical still stop the line.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package and repository metadata">
    <Product>Absence Concierge</Product>
    <Company>agent-eval-bench</Company>
    <Authors>Konrad Cinkusz</Authors>
    <!-- Copyright holder is kept byte-identical to LICENSE. One source of truth. -->
    <Copyright>Copyright (c) 2026 dev_insight</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/konradcinkusz/agent-eval-bench</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="Never pack, unless a project opts in">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Test projects: conventionally named *.Tests, living under tests/. They are not
    packable, they do not need XML documentation, and they run with the same analyzer
    posture as production code because an eval harness that fails to compile cleanly
    is an eval harness nobody trusts.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
