<Project>

  <!--
    Directory.Packages.props — central package management.

    Every NuGet version used anywhere in this repository is declared exactly once,
    here. A project references a package by name only:

        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />

    with no Version attribute. That is what makes "upgrade this library" a one-line
    diff instead of ten, and what makes version skew inside one solution impossible
    rather than merely unlikely (REPO-BASELINE.md §1).

    Dependabot (.github/dependabot.yml, nuget ecosystem) opens PRs against this file.

    Every version below was verified to exist on nuget.org before being pinned, and
    Aspire 13.4.6 was verified to ship a net10.0 target.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AspireVersion>13.5.3</AspireVersion>
    <OpenTelemetryVersion>1.18.0</OpenTelemetryVersion>
    <ExtensionsVersion>10.9.0</ExtensionsVersion>
  </PropertyGroup>

  <ItemGroup Label="Aspire — the composition root (P1), development-time only">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireVersion)" />
  </ItemGroup>

  <ItemGroup Label="The shared kernel: telemetry, health, discovery, resilience (P2)">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$(ExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="$(ExtensionsVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryVersion)" />
    <!--
      The trace sink the production loop reads (docs/PRODUCTION.md, D-12). An
      exporter, not the Application Insights SDK: the spans stay OpenTelemetry's,
      Azure Monitor is one place they can land, and the eval harness goes on
      reading them in-process with nothing configured. Verified on nuget.org.
    -->
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.3" />
  </ItemGroup>

  <ItemGroup Label="Agent service">
    <!--
      The mock workforce tools read the same fixture file the eval scenarios name,
      so there is one source of truth for the world rather than two that drift.
    -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!--
      The Model Context Protocol client, behind IMcpToolSession and named in exactly
      one file. `.Core` rather than the full package: this repository is an MCP
      *client*, and the superset adds server hosting and DI extensions it has no use
      for. Verified on nuget.org to ship a net10.0 target.
    -->
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <!--
      TRX output under the native Microsoft.Testing.Platform engine (global.json's
      test.runner) is an opt-in extension, not a default — MTP ships only the
      runner itself and lets each project pick its reporters. The report-trx flag
      has nothing to report with until this is referenced. xunit.runner.visualstudio
      (the VSTest bridge adapter) is gone: the engine it bridged to is the one
      global.json now refuses to use.
    -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
    <!-- Captures spans in-process so a test can assert that one was exported. -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="$(OpenTelemetryVersion)" />
  </ItemGroup>

</Project>
