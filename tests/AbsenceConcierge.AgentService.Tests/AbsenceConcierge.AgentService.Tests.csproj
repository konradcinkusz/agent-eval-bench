<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit v3 runs as its own process. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AbsenceConcierge.AgentService/AbsenceConcierge.AgentService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests read the same fixture the service and the scenarios do. -->
    <Content Include="../../evals/fixtures/*.yaml"
             Link="fixtures/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
