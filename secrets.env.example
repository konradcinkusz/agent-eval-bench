# ============================================================================
#  agent-eval-bench — documented environment variables
# ============================================================================
#
#  Copy to `.env` (gitignored) and fill in only what you need:
#
#      cp secrets.env.example .env
#
#  THE HEADLINE: every variable in this file is OPTIONAL. A fresh clone with an
#  empty .env runs the agent, the showcase page and the full Layer-1 eval suite,
#  green, with zero credentials. That is the P8 contract — "git clone && dotnet run
#  with zero cloud credentials must produce a working system with reduced features"
#  — and it is a deliberate property of this repository, not an accident of it
#  being early.
#
#  Each variable below carries a TIER and a DEGRADES line. The DEGRADES line is the
#  important one: it says exactly what stops working if you skip the variable, so
#  skipping is an informed choice (REPO-BASELINE.md §3).
#
#  TIERS
#    [always]    required for the repository to function at all — currently NONE
#    [mode]      required to enable one optional mode; absent ⇒ that mode is off
#    [ci]        set as a GitHub Actions secret, not locally
#    [optional]  improves something; absent ⇒ a documented fallback
#
#  The journey of any value, once:
#      .env (local)  →  environment variable  →  IConfiguration key  →  options class
#  The `__` double underscore in a variable name is the section separator:
#  `Llm__ApiKey` binds to configuration key `Llm:ApiKey`.
#
#  NOTHING IN THIS FILE EVER HOLDS A REAL VALUE. It is committed; .env is not.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. Workforce tools — where the agent's read/write capabilities come from
# ----------------------------------------------------------------------------

# [mode] Mock (default) | Mcp
#   Mock : in-memory fixtures, deterministic, no network, no credentials. This is
#          the product: the demo, the evals and CI all run on it.
#   Mcp  : the live Model Context Protocol server. Local and dev only — it acts as
#          a real identity against a real workforce system, so it is NEVER enabled
#          on the public deployment.
# DEGRADES: unset ⇒ Mock. Nothing is lost except the live integration.
WorkforceTools__Mode=Mock

# [mode] Base URL of the MCP server. Required only when Mode=Mcp.
# DEGRADES: absent ⇒ Mcp mode refuses to start and the service stays on Mock,
#           with a log line naming this variable. It does not fail startup (P8).
WorkforceTools__Mcp__ServerUrl=

# [secret] Bearer token presented to the MCP server on every call.
#
# The adapter takes a token; it does not acquire one. OAuth 2.0 with dynamic client
# registration is what a server like Factorial's actually speaks, and implementing
# that flow against a server this repository has never reached would be code written
# from documentation and tested by nothing (docs/DEVIATIONS.md D-11). So the token is
# obtained out of band and pasted here, which is honest about what has been built.
#
# DEGRADES: absent ⇒ Mcp mode unavailable, Mock stays, with a log line naming this
#           variable. It does not fail startup (P8).
WorkforceTools__Mcp__AccessToken=

# [tuning] Seconds before a single tool call is abandoned. Default 30.
# A write abandoned this way is reported as "may or may not have happened" and is
# never retried — see docs/SPEC.md §7.2.
WorkforceTools__Mcp__TimeoutSeconds=


# ----------------------------------------------------------------------------
# 2. LLM provider — the model behind the agent loop
# ----------------------------------------------------------------------------

# [mode] Replay (default) | AzureOpenAI | OpenAiCompatible
#   Replay : recorded model responses, replayed deterministically. Zero cost, zero
#            credentials, and the reason Layer-1 evals are reproducible.
# DEGRADES: unset ⇒ Replay.
Llm__Provider=Replay

# [mode] Azure OpenAI endpoint, deployment name and key.
# DEGRADES: absent ⇒ provider falls back to Replay with a visible banner in the UI
#           and a log line. The agent still answers; it just answers from the
#           recording rather than from a live model.
Llm__Endpoint=
Llm__Deployment=
Llm__ApiKey=


# ----------------------------------------------------------------------------
# 3. Eval Layer 2 — the LLM judge
# ----------------------------------------------------------------------------

# [ci] The judge model is PINNED, in evals/rubrics/, and versioned with the suite.
#      A judge that silently upgrades is a measuring stick that changes length.
#      This variable carries the key only; the model id is not configurable here.
# DEGRADES: absent ⇒ the Layer-2 CI job reports SKIPPED with a reason. It does not
#           report green. An unrun judge that shows as passing is the single most
#           dangerous thing an eval suite can do.
Judge__ApiKey=


# ----------------------------------------------------------------------------
# 4. Observability (P15)
# ----------------------------------------------------------------------------

# [optional] OTLP/HTTP endpoint. Point it at a local collector, or at CopilotScope
#            to get the four-dimension composite scoring described in the README.
# DEGRADES: absent ⇒ traces are still produced in-process (the eval harness reads
#           them there), they are simply not exported anywhere.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=absence-concierge


# ----------------------------------------------------------------------------
# 5. Public demo posture — only relevant to the deployed instance
# ----------------------------------------------------------------------------

# [mode] Shared out of band. Unlocks live-LLM mode for one session on the public
#        deployment; anonymous visitors always get mock tools and replayed LLM.
# DEGRADES: absent ⇒ live-LLM mode cannot be unlocked by anyone. The demo is fully
#           experienceable without it.
PublicDemo__AccessCode=

# [optional] Hard daily ceiling on live-LLM spend, in tokens. When it is exhausted
#            the app degrades to Replay with a visible banner rather than erroring.
# DEGRADES: absent ⇒ a conservative built-in default applies.
PublicDemo__DailyTokenBudget=

# ----------------------------------------------------------------------------
# 6. Deployment — GitHub Actions secrets, never a local .env
# ----------------------------------------------------------------------------

# [ci] Fly.io deploy token. Repository secret, scoped to the deploy environment.
# DEGRADES: absent ⇒ the deploy workflow fails loudly, which is correct. Nothing
#           about local development or the eval suite needs it.
# FLY_API_TOKEN=
