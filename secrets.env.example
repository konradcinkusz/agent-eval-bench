# ============================================================================
#  agent-eval-bench — documented environment variables
# ============================================================================
#
#  Copy to `.env` (gitignored) and fill in only what you need:
#
#      cp secrets.env.example .env
#
#  THE HEADLINE: every variable in this file is OPTIONAL. A fresh clone with an
#  empty .env runs the agent, the showcase page and the full Layer-1 eval suite,
#  green, with zero credentials. That is the P8 contract — "git clone && dotnet run
#  with zero cloud credentials must produce a working system with reduced features"
#  — and it is a deliberate property of this repository, not an accident of it
#  being early.
#
#  Each variable below carries a TIER and a DEGRADES line. The DEGRADES line is the
#  important one: it says exactly what stops working if you skip the variable, so
#  skipping is an informed choice (REPO-BASELINE.md §3).
#
#  TIERS
#    [always]    required for the repository to function at all — currently NONE
#    [mode]      required to enable one optional mode; absent ⇒ that mode is off
#    [secret]    a credential; from user-secrets locally, an environment secret in CI
#    [ci]        set as a GitHub Actions secret or variable, not locally
#    [tuning]    a number with a sane default; absent ⇒ the default
#
#  The journey of any value, once:
#      .env (local)  →  environment variable  →  IConfiguration key  →  options class
#  The `__` double underscore in a variable name is the section separator:
#  `Llm__ApiKey` binds to configuration key `Llm:ApiKey`.
#
#  NOTHING IN THIS FILE EVER HOLDS A REAL VALUE. It is committed; .env is not.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. Workforce tools — where the agent's read/write capabilities come from
# ----------------------------------------------------------------------------

# [mode] Mock (default) | Mcp
#   Mock : in-memory fixtures, deterministic, no network, no credentials. This is
#          the product: the demo, the evals and CI all run on it.
#   Mcp  : the live Model Context Protocol server. Local and dev only — it acts as
#          a real identity against a real workforce system, so it is NEVER enabled
#          on the public deployment, which carries none of these settings at all.
# DEGRADES: unset ⇒ Mock. Nothing is lost except the live integration.
WorkforceTools__Mode=Mock

# [mode] Which fixture world the mock serves. One file today: meridian-labs.
WorkforceTools__Fixture=meridian-labs

# [mode] Base URL of the MCP server. Required only when Mode=Mcp.
# DEGRADES: absent ⇒ Mcp mode is unavailable and the service stays on Mock, with a
#           log line naming this variable. It does not fail startup (P8).
WorkforceTools__Mcp__ServerUrl=

# [secret] Bearer token presented to the MCP server on every call.
#
# The adapter takes a token; it does not acquire one. OAuth 2.0 with dynamic client
# registration is what a server like Factorial's actually speaks, and implementing
# that flow against a server this repository has never reached would be code written
# from documentation and tested by nothing (docs/DEVIATIONS.md D-11). So the token is
# obtained out of band and pasted here, which is honest about what has been built.
#
# DEGRADES: absent ⇒ as above — Mcp mode unavailable, Mock stays.
WorkforceTools__Mcp__AccessToken=

# [tuning] Seconds before a single tool call is abandoned. Default 30.
# A write abandoned this way is reported as "may or may not have happened" and is
# never retried — see docs/SPEC.md §7.2 and §7.4.
WorkforceTools__Mcp__TimeoutSeconds=


# ----------------------------------------------------------------------------
# 2. The language model — used for the demo's live replies, and for the judge
# ----------------------------------------------------------------------------

# [mode] None (default) | AzureOpenAI | AnthropicFoundry
#   None            : no model, no network, no cost. Replies are composed
#                     deterministically. This is what the whole eval suite runs on.
#   AzureOpenAI     : addressed by DEPLOYMENT NAME, not model id.
#   AnthropicFoundry: named, and NOT IMPLEMENTED — selecting it throws at startup
#                     with the reason (docs/DEVIATIONS.md D-8). "No key is present"
#                     and "the code was never written" are different facts, and the
#                     second must not be reported as a missing credential.
# DEGRADES: unset ⇒ None.
Llm__Provider=None

# [mode] The Azure OpenAI ENDPOINT and DEPLOYMENT NAME. A deployment name is not a
#        model id, and conflating them is the usual way a first call fails.
# DEGRADES: absent ⇒ the provider reports itself unconfigured rather than
#           half-configured. The agent still answers; the deterministic composer
#           writes the reply and the page's banner says so.
Llm__Endpoint=
Llm__Model=

# [secret] The API key. From `dotnet user-secrets` locally, an environment secret in
#          CI, `flyctl secrets set` in production. Never a file in this repository.
Llm__ApiKey=

# [tuning] Ceiling on one generation. Default 1024.
Llm__MaxOutputTokens=


# ----------------------------------------------------------------------------
# 3. Eval Layer 2 — the LLM judge
# ----------------------------------------------------------------------------

# [ci] The judge's model, endpoint and key, set on the `evals` GitHub environment
#      and used by .github/workflows/nightly.yml. The judge model is PINNED in
#      evals/rubrics/judge.yaml and versioned with the suite; this variable names
#      the deployment that serves it, and a mismatch is recorded in the report
#      rather than silently accepted (ADR-0004).
#
# DEGRADES: absent ⇒ every judged scenario reports `skipped:no-credential`. It does
#           NOT report green. An unrun judge that shows as passing is the single
#           most dangerous thing an eval suite can do.
Llm__JudgeModel=

# [tuning] Per-million-token prices, so the report can state a cost rather than a
#          token count. Absent ⇒ the report says tokens and no money.
Llm__PricePerMillionInputTokens=
Llm__PricePerMillionOutputTokens=

# [ci] smoke (default on a pull request) | full. The nightly run sets `full`, and a
#      test asserts that it does — the keyed run is not optional.
EVAL_LAYER2_SCOPE=


# ----------------------------------------------------------------------------
# 4. Observability (P15)
# ----------------------------------------------------------------------------

# [tuning] OTLP/HTTP endpoint. Point it at a local collector to watch the same trace
#          the eval suite grades.
# DEGRADES: absent ⇒ traces are still produced in-process (the eval harness reads
#           them there), they are simply not exported anywhere.
#
# NOT SET HERE, and worth knowing about: OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT truncates
# attribute values at export. `workforce.tool.result_ids` is what gets cut, and it is
# the attribute that makes the grounding constraint answerable from the trace rather
# than from trust. See docs/PRODUCTION.md §1.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=absence-concierge


# ----------------------------------------------------------------------------
# 5. The public demo — spend controls
# ----------------------------------------------------------------------------

# [secret] Unlocks live model replies for whoever supplies it.
#
# NOT authentication, and flyio/SECRETS.md says so at more length. It is a spend
# control: it answers "is this somebody I gave a code to?", which is enough to keep
# a paid model off a public endpoint and nowhere near enough to protect data. There
# is no data here to protect — every visitor sees the same fictional company.
#
# DEGRADES: absent ⇒ live replies are UNAVAILABLE, not open. That direction is the
#           whole design: a missing secret is the normal state of a fork and a
#           preview environment, and a default that failed open would make every one
#           of them an unmetered spend.
Demo__AccessCode=

# [tuning] Output tokens the live composer may spend per UTC day, across everyone.
# A hard ceiling rather than an alert. Spent ⇒ the deterministic composer answers and
# the page's banner says why, until midnight UTC. Default 20000.
Demo__DailyOutputTokenBudget=

# [tuning] Per-reply output ceiling. A reply is two or three sentences. Default 300.
Demo__MaxOutputTokensPerReply=

# [tuning] Turns per IP per minute, whether or not live mode is unlocked. Default 20.
Demo__RequestsPerMinutePerClient=


# ----------------------------------------------------------------------------
# 6. Deployment — GitHub Actions secrets, never a local .env
# ----------------------------------------------------------------------------

# [ci] Fly.io deploy token. Set on the `demo` environment so a reviewer can see in
#      the repository settings which workflow is allowed to spend it.
# DEGRADES: absent ⇒ the deploy workflow fails loudly, naming this variable. Nothing
#           about local development or the eval suite needs it.
# FLY_API_TOKEN=
